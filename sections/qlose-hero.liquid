{%- comment -%} Ported from docs/design-source/index.html:114-257, 952-977 {%- endcomment -%}

{%- liquid
  assign cta_blocks = section.blocks | where: 'type', 'cta'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign sticky_cta = cta_blocks | first
-%}

<section class="qlose-hero">
  <div class="qlose-hero__meta">
    <span><strong>{{ section.settings.meta_left }}</strong></span>
    <span>{{ section.settings.meta_right }}</span>
  </div>

  <div class="qlose-hero__main">
    <div class="qlose-hero__copy">
      {%- comment -%}
        The <p> wrapper richtext adds is stripped: <p> inside <h1> is invalid.
      {%- endcomment -%}
      <h1 class="qlose-hero__headline qlose-display">
        {{- section.settings.headline | replace: '<p>', '' | replace: '</p>', '' -}}
      </h1>

      {%- comment -%}
        Two versions of the sentence under the headline. On a phone the hero
        has to make its case in one screen, so a shorter, price-carrying line
        can be set for small screens; when it is blank the long one shows
        everywhere.
      {%- endcomment -%}
      <div class="qlose-hero__sub{% if section.settings.subtext_mobile != blank %} qlose-hero__sub--desktop{% endif %}">
        {{ section.settings.subtext }}
      </div>
      {%- if section.settings.subtext_mobile != blank -%}
        <p class="qlose-hero__sub qlose-hero__sub--mobile">{{ section.settings.subtext_mobile }}</p>
      {%- endif -%}

      <div class="qlose-hero__cta">
        {%- for block in cta_blocks -%}
          <span
            class="qlose-hero__cta-item{% if block.settings.hide_mobile %} qlose-hero__cta-item--desktop{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- render 'qlose-button',
                label: block.settings.label,
                url: block.settings.url,
                style: block.settings.style
            -%}
          </span>
        {%- endfor -%}
      </div>

      {%- comment -%}
        Reasons to trust the buttons, right under them: delivery, the
        subscription's exit, where the kit is made. Facts, not slogans; each
        one is a merchant-editable block so a claim can be removed the day it
        stops being true.
      {%- endcomment -%}
      {%- if trust_blocks.size > 0 -%}
        <ul class="qlose-hero__trust" role="list">
          {%- for block in trust_blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg class="qlose-hero__check" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M2 6.2l2.6 2.6L10 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="qlose-hero__visual">
      {%- if section.settings.tag != blank -%}
        <div class="qlose-hero__tag">{{ section.settings.tag }}</div>
      {%- endif -%}

      {%- comment -%}
        This is the LCP element, hence fetchpriority high and no lazy loading.
        The source inlined a 300 KB base64 PNG with no width/height, which
        cost both a render-blocking payload and a layout shift.
      {%- endcomment -%}
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '400,600,900,1200',
            sizes: '(max-width: 900px) 90vw, 40vw',
            fetchpriority: 'high',
            class: 'qlose-hero__img',
            alt: section.settings.image.alt | default: shop.name
        }}
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    Phone-only buy bar. It slides in once the hero's buttons have scrolled off
    the top, so the next step is always one thumb away while the page is
    making its case, and it never covers the buttons it duplicates. Same
    label and link as the first button, so there is one thing to keep in sync.
  {%- endcomment -%}
  {%- if section.settings.sticky_mobile and sticky_cta and sticky_cta.settings.url != blank -%}
    <div class="qlose-hero__sticky" data-qlose-sticky aria-hidden="true">
      {%- if section.settings.sticky_text != blank -%}
        <span class="qlose-hero__sticky-text">{{ section.settings.sticky_text }}</span>
      {%- endif -%}
      <a href="{{ sticky_cta.settings.url }}" class="qlose-btn qlose-btn--primary" tabindex="-1">
        {{- sticky_cta.settings.label -}}
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .qlose-hero {
    padding: 60px var(--qlose-gutter) 100px;
    max-width: var(--qlose-max);
    margin-inline: auto;
    position: relative;
  }

  .qlose-hero__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--qlose-divider);
    font-family: var(--qlose-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--qlose-muted);
  }

  .qlose-hero__meta strong {
    color: var(--qlose-black);
    font-weight: 500;
  }

  .qlose-hero__main {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .qlose-hero__headline {
    /* Source min was 72px, which overflows a 320px viewport on the word
       "EVERY" and gives the whole page a horizontal scrollbar.

       The max came down from 180px. Five lines at 0.85 leading make the
       headline four and a quarter times its own font size, so 180px stood
       765px tall and pushed the sentence, the buttons and the product past
       the fold on every laptop -- the loudest thing on the page was also the
       only thing on it. At 104px the whole hero lands in one screen and the
       type still reads as the display face it is. */
    font-size: clamp(52px, 8.5vw, 104px);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--qlose-black);
    margin-bottom: 40px;
  }

  .qlose-hero__sub {
    max-width: 400px;
    font-size: 15px;
    color: var(--qlose-graphite);
    margin-bottom: 40px;
    line-height: 1.6;
  }

  .qlose-hero__sub--mobile {
    display: none;
  }

  .qlose-hero__cta {
    display: flex;
    gap: 12px;
    /* Centring lined up the boxes, which are not the same height as each
       other and nothing like the height of the text link -- so the three
       labels sat on three different lines. Baseline lines up the words,
       which is what the eye actually reads along. */
    align-items: baseline;
    flex-wrap: wrap;
  }

  /* Two buttons are the choice; the link is the way out of making it. Twice
     the gap keeps it from reading as a third button. */
  .qlose-hero__cta > span:has(.qlose-btn--underline) {
    margin-left: 12px;
  }

  .qlose-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--qlose-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--qlose-graphite);
  }

  .qlose-hero__trust li {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.3;
  }

  .qlose-hero__check {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--qlose-accent);
  }

  .qlose-hero__visual {
    /* Was 4/5. On a wide screen the column is around 580px, so the portrait
       frame stood over 700px tall -- half again the height of the headline,
       sentence and buttons put together, and the bottom of it fell past the
       fold. Square keeps the frame the tallest thing in the row without
       making the row taller than the screen. The case itself is unaffected:
       it is held by max-width, not max-height, so shortening the frame
       crops nothing. */
    aspect-ratio: 1 / 1;
    background: linear-gradient(180deg, var(--qlose-accent-soft) 0%, var(--qlose-bone) 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Centred against the frame rather than by the flex box around it: the
     cap below is a share of a height the frame takes from aspect-ratio alone,
     and WebKit hands a child no percentage of one of those. Where the cap is
     lost the photograph keeps its own height, which for a tall file is several
     times the square. inset with auto margins centres it and the percentages
     resolve. See sections/qlose-routine-step.liquid for the long version. */
  .qlose-hero__img {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: 88%;
    max-height: 60%;
    width: auto;
    height: auto;
    object-fit: contain;
    transform: rotate(-8deg);
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.35));
  }

  .qlose-hero__tag {
    position: absolute;
    top: 30px;
    right: 30px;
    background: var(--qlose-accent);
    color: var(--qlose-white);
    padding: 10px 16px;
    font-family: var(--qlose-font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* The buy bar exists only on small screens; see the 900px block. Off
     screen by transform rather than display so it can slide in. */
  .qlose-hero__sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px var(--qlose-gutter) calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--qlose-off-white);
    border-top: 1px solid var(--qlose-divider);
    box-shadow: 0 -12px 30px rgba(10, 10, 10, 0.08);
    transform: translateY(110%);
    transition: transform 0.25s ease;
  }

  .qlose-hero__sticky.is-visible {
    transform: none;
  }

  .qlose-hero__sticky-text {
    font-family: var(--qlose-font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--qlose-graphite);
    line-height: 1.35;
  }

  .qlose-hero__sticky .qlose-btn {
    flex: none;
    padding: 14px 20px;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .qlose-hero__main {
      gap: 40px;
    }
  }

  /* Small screens: the product first.

     Stacked in source order the phone opened on a meta line, a four-line
     headline, a paragraph and three buttons, and the case did not appear
     until a screen and a half down -- a shop with nothing for sale in the
     window. The grid wrapper dissolves (display: contents) so the frame, the
     meta line and the copy are siblings of one column and can be ordered:
     picture, one-line positioning, headline, short sentence, buttons, trust.
     Everything is sized so the first button sits inside the first screen of
     an ordinary phone with the header above it. */
  @media (max-width: 900px) {
    .qlose-hero {
      display: flex;
      flex-direction: column;
      padding-block: 16px 48px;
    }

    .qlose-hero__main {
      display: contents;
    }

    .qlose-hero__visual {
      order: -1;
      aspect-ratio: 4 / 3;
      /* Capped against the screen, not the column: a tablet column is 780px
         wide, and 4:3 of that is a frame taller than the copy under it. On a
         short phone the cap is what keeps the first button on screen one. */
      max-height: min(38vh, 420px);
      margin-bottom: 16px;
    }

    .qlose-hero__img {
      max-width: 84%;
      max-height: 74%;
      filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.3));
    }

    .qlose-hero__tag {
      top: 16px;
      right: 16px;
      padding: 8px 12px;
    }

    .qlose-hero__meta {
      margin-bottom: 14px;
      padding-bottom: 10px;
      font-size: 10px;
    }

    .qlose-hero__headline {
      font-size: clamp(40px, 11.5vw, 64px);
      margin-bottom: 14px;
    }

    .qlose-hero__sub {
      margin-bottom: 18px;
    }

    .qlose-hero__sub--desktop {
      display: none;
    }

    .qlose-hero__sub--mobile {
      display: block;
    }

    .qlose-hero__trust {
      margin-top: 20px;
    }

    .qlose-hero__sticky {
      display: flex;
    }
  }

  /* Two of these labels carry a price, so neither fits beside the other on a
     phone and the row breaks into a ragged stack of differing widths. Stacked
     to full width instead; the underline variant keeps its content width,
     since a rule drawn across the whole screen reads as a divider. */
  @media (max-width: 480px) {
    .qlose-hero__cta {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .qlose-hero__cta > span {
      display: flex;
    }

    .qlose-hero__cta > span:has(.qlose-btn--underline) {
      align-self: center;
      margin-left: 0;
      margin-top: 6px;
    }

    .qlose-hero__cta .qlose-btn {
      flex: 1;
      text-align: center;
      padding-inline: 16px;
    }

    .qlose-hero__trust {
      flex-direction: column;
      gap: 9px;
    }
  }

  /* After the stacking rules above, which set display on the same spans and
     would otherwise win on specificity. */
  @media (max-width: 900px) {
    .qlose-hero__cta > span.qlose-hero__cta-item--desktop {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const bar = document.querySelector('[data-qlose-sticky]');
    const anchor = document.querySelector('.qlose-hero__cta');
    if (!bar || !anchor || !('IntersectionObserver' in window)) return;

    const small = window.matchMedia('(max-width: 900px)');
    const link = bar.querySelector('a');

    const show = (on) => {
      bar.classList.toggle('is-visible', on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      if (link) link.tabIndex = on ? 0 : -1;
    };

    // Visible only once the hero's own buttons have gone past the top of
    // the screen, never while they are still below it.
    const observer = new IntersectionObserver(
      ([entry]) => {
        const passed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        show(passed && small.matches);
      },
      { threshold: 0 }
    );
    observer.observe(anchor);
    small.addEventListener('change', () => { if (!small.matches) show(false); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "QLOSE hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "meta_left", "label": "Meta left", "default": "THE COMPLETE MOUTH ROUTINE" },
    { "type": "text", "id": "meta_right", "label": "Meta right", "default": "LONDON" },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>EVERY TOOL. THE RIGHT ORDER.</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>A five-piece oral care system, in two versions, manual or electric.</p>"
    },
    {
      "type": "textarea",
      "id": "subtext_mobile",
      "label": "Subtext on phones",
      "info": "Shown instead of the subtext on screens under 900px. Keep it to two lines and put the price in it. Leave empty to show the same subtext everywhere."
    },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "tag", "label": "Corner tag", "default": "THE KITS" },
    { "type": "header", "content": "Phone buy bar" },
    {
      "type": "checkbox",
      "id": "sticky_mobile",
      "label": "Show a buy bar on phones once the buttons scroll away",
      "default": true,
      "info": "Uses the first button's label and link."
    },
    { "type": "text", "id": "sticky_text", "label": "Buy bar text", "default": "Two kits, from £29" }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "Button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "url", "id": "url", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "ghost", "label": "Ghost" },
            { "value": "underline", "label": "Underline" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "hide_mobile",
          "label": "Hide on phones",
          "default": false,
          "info": "Keeps the first screen of a phone to the actions that sell."
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust line",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on subscriptions" }
      ]
    }
  ],
  "presets": [{ "name": "QLOSE hero" }]
}
{% endschema %}
