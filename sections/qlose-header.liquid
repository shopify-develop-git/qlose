{%- comment -%} Ported from docs/design-source/index.html:71-112, 895-926, 935-950 {%- endcomment -%}

<script src="{{ 'cart-icon.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'qlose-header.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- comment -%}
  The band paints full width; the inner element carries the content rail so the
  logo lines up with the hero below it. The source's nav has no such wrapper --
  it pads 40px off the viewport edge while every section under it is capped at
  1500px -- which leaves the header hanging off the grid on a wide screen. The
  source's own footer has the wrapper, so the rail was clearly the intent.
{%- endcomment -%}
<qlose-header class="qlose-header">
  <div class="qlose-header__inner">
    <a href="{{ routes.root_url }}" class="qlose-header__logo">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 400
          | image_tag: widths: '200,400', alt: shop.name, class: 'qlose-header__logo-img'
        }}
      {%- else -%}
        <img
          src="{{ 'qlose-logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="400"
          height="47"
          class="qlose-header__logo-img"
        >
      {%- endif -%}
    </a>

    <ul class="qlose-header__menu" id="QloseHeaderMenu" ref="menu">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>

    <button
      class="qlose-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="QloseHeaderMenu"
      ref="toggle"
    >
      Menu
    </button>

    <div class="qlose-header__actions">
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}" class="qlose-header__cart">
        <cart-icon class="qlose-header__cart-icon">
          <span>Cart</span>
          <span aria-hidden="true">/</span>
          {% render 'cart-bubble', limit: 100 %}
        </cart-icon>
      </a>
    </div>
  </div>

  {%- comment -%}
    Backdrop for the open menu. Fixed to the viewport but sat at z-index -1
    inside the sticky header group's stacking context, so it dims everything
    the group paints over -- the whole page -- while the announcement bar and
    the nav itself stay above it, unshaded.
  {%- endcomment -%}
  <div class="qlose-header__scrim" ref="scrim" aria-hidden="true"></div>
</qlose-header>

{% stylesheet %}
  .qlose-header {
    display: block;
    position: relative;
    background: var(--qlose-off-white);
    border-bottom: 1px solid var(--qlose-divider);
  }

  /* Same box as .qlose-section and .qlose-hero -- max-width and gutter on one
     element -- so the logo sits on exactly the left edge of the hero copy. */
  .qlose-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--qlose-max);
    margin-inline: auto;
    padding: 24px var(--qlose-gutter);
  }

  .qlose-header__logo-img {
    height: 22px;
    width: auto;
    display: block;
  }

  .qlose-header__menu {
    display: flex;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .qlose-header__menu a,
  .qlose-header__actions a {
    color: var(--qlose-black);
    text-decoration: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--qlose-font-sans);
  }

  .qlose-header__actions {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .qlose-header__cart-icon {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Horizon hides the count when the cart is empty, but keeps the value "0"
     in the DOM. The design calls for a permanently visible "Cart / 0", so we
     put it back in flow instead of forking cart-icon.js.

     !important is required, not sloppiness: base.css declares
     `.hidden { display: none !important }` and
     `.visually-hidden:not(:focus,:active) { position: absolute !important }`.
     Our selectors already outrank them on specificity, but !important wins
     over specificity, so the only way to override is in kind. Scoped to this
     header so no other cart bubble in the theme is affected. */
  .qlose-header__cart-icon .cart-bubble.visually-hidden {
    position: static !important;
    clip: auto !important;
    clip-path: none !important;
    width: auto !important;
    height: auto !important;
    overflow: visible !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
  }

  .qlose-header__cart-icon .cart-bubble__text-count.hidden {
    display: inline !important;
  }

  .qlose-header__cart-icon .cart-bubble {
    width: auto;
    aspect-ratio: auto;
    padding: 0;
    color: var(--qlose-black);
  }

  .qlose-header__cart-icon .cart-bubble__background {
    display: none;
  }

  .qlose-header__cart-icon .cart-bubble__text {
    font-family: var(--qlose-font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  /* Never shown above the menu breakpoint: the toggle is hidden there, so the
     open state cannot be reached, but a viewport resized while open would
     otherwise leave the page dimmed with no way to clear it. */
  .qlose-header__scrim {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgb(10 10 10 / 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .qlose-header__scrim {
      transition: none;
    }
  }

  .qlose-header__toggle {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    font-family: var(--qlose-font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--qlose-black);
  }

  /* The source wraps the bar and lets the toggle fall to a second line. That is
     only invisible at the 900px it was checked against: at phone widths the
     logo alone eats half the row, so the button drops below the logo and the
     header grows to two storeys. The row stays on one line here, and the type
     steps down to make it fit. */
  @media (max-width: 900px) {
    .qlose-header__inner {
      flex-wrap: nowrap;
      gap: 16px;
      padding-block: 16px;
    }

    /* The logo is the only thing here that can give: the links are held at
       their content width by white-space, so at 320px it takes the squeeze
       rather than the row overflowing into a horizontal scrollbar. */
    .qlose-header__logo {
      min-width: 0;
      flex: 0 1 auto;
    }

    .qlose-header__logo-img {
      height: 18px;
      max-width: 100%;
    }

    .qlose-header__actions {
      gap: 16px;
      flex: none;
    }

    .qlose-header__menu a,
    .qlose-header__actions a,
    .qlose-header__cart-icon .cart-bubble__text {
      white-space: nowrap;
    }

    .qlose-header__toggle {
      display: block;
      order: 3;
      flex: none;
      padding: 8px 0;
    }

    /* Out of flow, so opening the menu lays it over the page instead of
       pushing everything down. It hangs off the band rather than the inner
       rail so the panel spans the full width, and the sticky header group it
       sits in already carries the stacking context that puts it on top. */
    .qlose-header__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0 var(--qlose-gutter) 16px;
      background: var(--qlose-off-white);
      border-bottom: 1px solid var(--qlose-divider);
    }

    .qlose-header__menu--open {
      display: flex;
    }

    .qlose-header--open .qlose-header__scrim {
      opacity: 1;
      visibility: visible;
    }

    .qlose-header__menu li {
      border-top: 1px solid var(--qlose-divider);
      padding: 14px 0;
    }

    .qlose-header__menu a {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .qlose-header__logo-img {
      height: 16px;
    }

    .qlose-header__inner {
      gap: 12px;
    }

    .qlose-header__actions {
      gap: 12px;
    }

    /* The bar only. The links inside the open panel keep their 14px, since
       nothing there is competing for horizontal room. */
    .qlose-header__actions a,
    .qlose-header__toggle,
    .qlose-header__cart-icon .cart-bubble__text {
      font-size: 11px;
      letter-spacing: 0.06em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE header",
  "tag": "header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "presets": [{ "name": "QLOSE header" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
