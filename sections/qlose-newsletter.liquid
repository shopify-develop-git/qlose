{%- comment -%}
  Ported from docs/design-source/journal.html, section .newsletter. The
  source had a decorative input; this is a real Shopify customer form, so a
  submission actually creates a subscriber.
{%- endcomment -%}

<section class="qlose-newsletter">
  <div class="qlose-newsletter__inner">
    <h2 class="qlose-newsletter__heading qlose-display">
      {{- section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -}}
    </h2>

    {%- if section.settings.text != blank -%}
      <div class="qlose-newsletter__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'qlose-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- comment -%}
        A plain settable label rather than a translation key: every other
        string in this theme is brand copy set in the editor, and borrowing
        a Horizon locale key ties us to their key names.
      {%- endcomment -%}
      <label class="visually-hidden" for="QloseNewsletterEmail-{{ section.id }}">
        {{ section.settings.email_label }}
      </label>
      {%- comment -%}
        The field and its submit share one underline, so they need a row of
        their own -- the form also carries the validation message, which must
        not sit inside that rule.
      {%- endcomment -%}
      <div class="qlose-newsletter__field">
        <input
          id="QloseNewsletterEmail-{{ section.id }}"
          class="qlose-newsletter__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="qlose-newsletter__submit">
          {{ section.settings.button_label }}
        </button>
      </div>

      {%- if form.errors -%}
        <p class="qlose-newsletter__message qlose-newsletter__message--error" role="alert">
          {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
        </p>
      {%- elsif form.posted_successfully? -%}
        <p class="qlose-newsletter__message" role="status">{{ section.settings.success_text }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .qlose-newsletter {
    background: var(--qlose-black);
    color: var(--qlose-white);
    padding: 120px var(--qlose-gutter);
    text-align: center;
  }

  .qlose-newsletter__heading {
    font-size: clamp(40px, 5vw, 80px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--qlose-white);
    margin-bottom: 24px;
  }

  .qlose-newsletter__text {
    max-width: 500px;
    margin: 0 auto 40px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  /* One underlined line, not a bordered box beside a filled button: the field
     and its submit share a single rule along the bottom, which is how the
     source draws it. */
  .qlose-newsletter__form {
    max-width: 500px;
    margin: 0 auto;
  }

  .qlose-newsletter__field {
    display: flex;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--qlose-white);
  }

  /* Two classes, not one. Horizon paints every text input from the theme
     palette with `input:not([type='checkbox'], [type='radio'])`, and :not()
     lends that selector the weight of its argument -- 0-1-1, above a single
     class. Left at one class the field came out as a white filled box. */
  .qlose-newsletter__field .qlose-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 12px 0;
    background: transparent;
    background-color: transparent;
    border: none;
    border-radius: 0;
    color: var(--qlose-white);
    font-family: var(--qlose-font-sans);
    font-size: 14px;
  }

  .qlose-newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .qlose-newsletter__submit {
    flex: none;
    padding: 12px 0;
    background: transparent;
    border: none;
    color: var(--qlose-white);
    font-family: var(--qlose-font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* The source drops focus styling entirely; keeping a ring, as everywhere
     else in this theme, since the field has no border of its own to shade. */
  .qlose-newsletter__input:focus-visible,
  .qlose-newsletter__submit:focus-visible {
    outline: 2px solid var(--qlose-accent);
    outline-offset: 4px;
  }

  .qlose-newsletter__message {
    max-width: 500px;
    margin: 16px auto 0;
    font-family: var(--qlose-font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .qlose-newsletter__message--error {
    color: #f3a58c;
  }

  @media (max-width: 900px) {
    .qlose-newsletter {
      padding: 40px var(--qlose-gutter);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>NEW PIECES, IN YOUR <em>inbox</em>.</p>",
      "info": "Italic renders as the serif accent, bold as the stroked outline."
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "email_label", "label": "Email field label", "default": "Email address", "info": "Read by screen readers; the field itself shows the placeholder." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe →" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks, you're on the list." }
  ],
  "presets": [{ "name": "QLOSE newsletter" }]
}
{% endschema %}
