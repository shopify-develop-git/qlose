{%- comment -%} Ported from docs/design-source/routine.html:192-238 {%- endcomment -%}

<section class="qlose-routine-hero">
  <div class="qlose-routine-hero__meta">
    <span><strong>{{ section.settings.meta_left }}</strong></span>
    <span>{{ section.settings.meta_right }}</span>
  </div>

  <h1 class="qlose-routine-hero__heading qlose-display">
    {{- section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -}}
  </h1>

  <div class="qlose-routine-hero__lead">{{ section.settings.lead }}</div>
</section>

{% stylesheet %}
  .qlose-routine-hero {
    padding: 80px var(--qlose-gutter) 60px;
    max-width: var(--qlose-max);
    margin-inline: auto;
  }

  /* The two halves wrap rather than compress. Without it the row is a two-item
     flex line with no way out: at 375px the pair asks for about 362px against
     335px of line, so both spans shrink and each breaks inside itself, and a
     one-line rule turns into a ragged block of four. Wrapping lets the second
     half drop whole. */
  .qlose-routine-hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--qlose-divider);
    margin-bottom: 40px;
    font-family: var(--qlose-font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--qlose-muted);
  }

  .qlose-routine-hero__meta > span {
    flex: 0 0 auto;
    max-width: 100%;
  }

  .qlose-routine-hero__meta strong {
    color: var(--qlose-black);
    font-weight: 500;
  }

  .qlose-routine-hero__heading {
    /* Source min was 72px, which overflows a 320px viewport. */
    font-size: clamp(52px, 12vw, 200px);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--qlose-black);
    margin-bottom: 40px;
  }

  .qlose-routine-hero__lead {
    max-width: 700px;
    font-size: 18px;
    color: var(--qlose-graphite);
    line-height: 1.5;
  }

  /* Same step down the page hero's meta takes, and for the same reason: at
     10px on 0.08em the pair comes to about 302px, which holds the rule on one
     line on a 375px phone instead of two. Narrower than that it wraps, which is
     what the rule above is for. */
  @media (max-width: 480px) {
    .qlose-routine-hero__meta {
      font-size: 10px;
      letter-spacing: 0.08em;
      margin-bottom: 28px;
    }
  }

  @media (max-width: 900px) {
    .qlose-routine-hero {
      padding-block: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE routine hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "meta_left", "label": "Meta left", "default": "THE METHOD" },
    { "type": "text", "id": "meta_right", "label": "Meta right", "default": "THE COMPLETE ROUTINE / 3 MINUTES" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>THE FIVE-STEP <em>clean</em>.</p>",
      "info": "Italic renders as the serif accent, bold as the stroked outline."
    },
    { "type": "richtext", "id": "lead", "label": "Lead" }
  ],
  "presets": [{ "name": "QLOSE routine hero" }]
}
{% endschema %}
