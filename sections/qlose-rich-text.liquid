{%- comment -%}
  Body copy for the legal pages. Typography ported from
  docs/design-source/privacy.html, section .legal-hero.
{%- endcomment -%}

<section class="qlose-rich-text">
  <div class="qlose-rich-text__inner qlose-prose">
    {%- if section.settings.pullquote != blank -%}
      <blockquote class="qlose-rich-text__pullquote">{{ section.settings.pullquote }}</blockquote>
    {%- endif -%}

    {%- if section.settings.use_page_content and page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      {{ section.settings.content }}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .qlose-rich-text {
    max-width: 900px;
    margin-inline: auto;
    padding: 60px var(--qlose-gutter) 120px;
  }

  .qlose-rich-text__pullquote {
    font-family: var(--qlose-font-serif);
    font-style: italic;
    font-size: 28px;
    line-height: 1.35;
    color: var(--qlose-black);
    margin: 0 0 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--qlose-divider);
    font-weight: 400;
  }

  @media (max-width: 700px) {
    .qlose-rich-text__pullquote {
      font-size: 22px;
    }
  }

  @media (max-width: 900px) {
    .qlose-rich-text {
      padding-bottom: 60px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE rich text",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_page_content",
      "label": "Use page content",
      "default": true,
      "info": "When on, renders the page body from the admin. When off, uses the text below."
    },
    { "type": "text", "id": "pullquote", "label": "Pull quote", "info": "Optional. Renders above the body." },
    { "type": "richtext", "id": "content", "label": "Content" }
  ],
  "presets": [{ "name": "QLOSE rich text" }]
}
{% endschema %}
