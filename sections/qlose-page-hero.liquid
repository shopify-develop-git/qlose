{%- comment -%}
  Page header, three variants. Sources:
    simple    -> docs/design-source/faq.html      (.simple-hero)
    legal     -> docs/design-source/privacy.html  (.legal-hero)
    editorial -> docs/design-source/journal.html  (.journal-hero)
{%- endcomment -%}

<section class="qlose-page-hero qlose-page-hero--{{ section.settings.variant }}">
  <div class="qlose-page-hero__inner">
    {%- if section.settings.meta_left != blank or section.settings.meta_right != blank -%}
      <div class="qlose-page-hero__meta">
        <span><strong>{{ section.settings.meta_left }}</strong></span>
        <span>{{ section.settings.meta_right }}</span>
      </div>
    {%- endif -%}

    <h1 class="qlose-page-hero__heading qlose-display">
      {%- if section.settings.heading != blank -%}
        {{- section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -}}
      {%- else -%}
        {{- page.title | default: shop.name -}}
      {%- endif -%}
    </h1>

    {%- if section.settings.subtext != blank -%}
      <div class="qlose-page-hero__sub">{{ section.settings.subtext }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* The source's .simple-hero measurements, which every page but About shares.
     About runs wider and deeper and overrides both below. */
  .qlose-page-hero {
    max-width: 1200px;
    margin-inline: auto;
    padding: 80px var(--qlose-gutter) 40px;
  }

  .qlose-page-hero--editorial {
    max-width: var(--qlose-max);
    padding-bottom: 60px;
  }

  /* The pair only breaks apart when it has to. Left alone, flex would shrink
     both halves and wrap each internally, giving two ragged stacks side by
     side; not shrinking means the second half drops to its own line instead,
     and only on the pages where the two do not fit -- the FAQ, the routine and
     the journal, whose meta runs to 49 characters. Everywhere else the row is
     untouched. max-width keeps that longest one wrapping inside the line
     rather than pushing past it. */
  .qlose-page-hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 16px;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--qlose-divider);
    font-family: var(--qlose-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--qlose-muted);
  }

  .qlose-page-hero__meta > span {
    flex: 0 0 auto;
    max-width: 100%;
  }

  .qlose-page-hero__meta strong {
    color: var(--qlose-black);
    font-weight: 500;
  }

  .qlose-page-hero__heading {
    color: var(--qlose-black);
    line-height: 0.85;
    letter-spacing: -0.05em;
    /* The source caps at 160px on a 10vw curve. Its 64px floor is kept off:
       at 375px a heading like "QUESTIONS," would not fit the measure and would
       break mid-word. Below ~440px only, this sits under the source. */
    font-size: clamp(44px, 10vw, 160px);
  }

  .qlose-page-hero--legal {
    border-bottom: 1px solid var(--qlose-divider);
  }

  /* about.html and routine.html both open on a full-bleed editorial
     headline, roughly double the simple variant. */
  .qlose-page-hero--editorial .qlose-page-hero__heading {
    font-size: clamp(52px, 12vw, 200px);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .qlose-page-hero--legal .qlose-page-hero__heading {
    font-size: clamp(36px, 5vw, 72px);
  }

  .qlose-page-hero__sub {
    margin-top: 32px;
    max-width: 600px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--qlose-graphite);
  }

  @media (max-width: 900px) {
    /* Asymmetric, as the desktop rule is: the heading needs air above it, and
       whatever follows supplies its own above itself. Symmetrical 40/40 left
       about 100px of empty ground under the headline on a phone. */
    .qlose-page-hero {
      padding-block: 40px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE page hero",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "simple", "label": "Simple" },
        { "value": "legal", "label": "Legal" },
        { "value": "editorial", "label": "Editorial" }
      ],
      "default": "simple"
    },
    { "type": "text", "id": "meta_left", "label": "Meta left" },
    { "type": "text", "id": "meta_right", "label": "Meta right" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Falls back to the page title when empty. Italic renders as the serif accent, bold as the stroked outline."
    },
    { "type": "richtext", "id": "subtext", "label": "Subtext" }
  ],
  "presets": [{ "name": "QLOSE page hero" }]
}
{% endschema %}
