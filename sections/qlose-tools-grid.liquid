{%- comment -%} Ported from docs/design-source/electric-kit.html:546-671, 163-206 {%- endcomment -%}

<section class="qlose-tools">
  <div class="qlose-tools__inner">
    <div class="qlose-tools__header">
      <div>
        {%- render 'qlose-eyebrow',
            index: section.settings.eyebrow_index,
            text: section.settings.eyebrow_text
        -%}
        <h2 class="qlose-tools__heading qlose-display">
          {{- section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -}}
        </h2>
      </div>
      <div class="qlose-tools__intro">{{ section.settings.intro }}</div>
    </div>

    <div class="qlose-tools__grid">
      {%- for block in section.blocks -%}
        <article class="qlose-tool" {{ block.shopify_attributes }}>
          <div class="qlose-tool__media">
            <div class="qlose-tool__media-inner">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    widths: '200,400,600',
                    sizes: '(max-width: 700px) 45vw, 18vw',
                    loading: 'lazy',
                    alt: block.settings.name
                }}
              {%- endif -%}
            </div>
          </div>
          <div class="qlose-tool__index">{{ block.settings.index }}</div>
          <h3 class="qlose-tool__name">{{ block.settings.name }}</h3>
          <p class="qlose-tool__material">{{ block.settings.material }}</p>
        </article>
      {%- endfor -%}
    </div>

    {%- comment -%}
      Back up to the product rather than off to the shop: this section sits
      below the buy box on a page the shopper is already on, so the five tools
      end where they started. Plain anchor, no script -- the theme sets
      scroll-behavior on the document, so the jump is already a scroll.

      A url set in the editor wins, which is what the section needs if it is
      ever placed on a page that carries no product.
    {%- endcomment -%}
    {%- if section.settings.cta_label != blank -%}
      {%- liquid
        assign cta_url = section.settings.cta_url
        if cta_url == blank
          assign cta_url = '#qlose-product'
        endif
      -%}
      <div class="qlose-tools__cta">
        {%- render 'qlose-button', label: section.settings.cta_label, url: cta_url, style: 'primary' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .qlose-tools {
    background: var(--qlose-bone);
    padding: 120px var(--qlose-gutter);
    border-top: 1px solid var(--qlose-divider);
    border-bottom: 1px solid var(--qlose-divider);
  }

  .qlose-tools__inner {
    max-width: var(--qlose-max);
    margin: 0 auto;
  }

  .qlose-tools__header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-bottom: 80px;
    align-items: end;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--qlose-divider);
  }

  .qlose-tools__heading {
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--qlose-black);
  }

  .qlose-tools__intro {
    font-size: 15px;
    color: var(--qlose-graphite);
    line-height: 1.6;
    padding-bottom: 8px;
  }

  /* minmax(0, 1fr) and min-width, the pair. A bare fr track is floored at
     the width of the widest thing in it, and a grid item is floored at its own
     contents in turn -- here a photograph, which reports a width of its own
     and holds the column open at it. Two of those side by side are wider than
     a phone, and the page scrolls sideways rather than the cards getting
     smaller. Same floor, same fix, as the gallery on this page. */
  .qlose-tools__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
  }

  .qlose-tool {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .qlose-tool__media {
    aspect-ratio: 3 / 4;
    background: linear-gradient(180deg, var(--qlose-bone) 0%, var(--qlose-off-white) 100%);
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .qlose-tool:hover .qlose-tool__media {
    background: linear-gradient(180deg, var(--qlose-accent-soft) 0%, var(--qlose-bone) 100%);
  }

  /* Positioned against the 3:4 frame rather than stretched to 100% of it. A
     percentage of a height that aspect-ratio alone decided is a percentage
     WebKit leaves unresolved, and the tool renders below it are tall enough
     that losing the cap shows one at several times its size. Same reasoning
     as the frame in sections/qlose-routine-step.liquid. */
  .qlose-tool__media-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 20px;
  }

  .qlose-tool__media-inner img {
    max-width: 75%;
    max-height: 85%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 25px 40px rgba(0, 0, 0, 0.28));
    transition: transform 0.4s ease;
  }

  .qlose-tool:hover .qlose-tool__media-inner img {
    transform: translateY(-8px) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .qlose-tool__media,
    .qlose-tool__media-inner img {
      transition: none;
    }

    .qlose-tool:hover .qlose-tool__media-inner img {
      transform: none;
    }
  }

  /* Centred under the grid rather than set beside the intro: it is the answer
     to the five tools above it, and it reads as one only after they have been
     seen. The cross-sell further down the same page is a ghost button on the
     same bone ground, so the filled one here keeps the order of the two
     obvious. */
  .qlose-tools__cta {
    display: flex;
    justify-content: center;
    margin-top: 60px;
  }

  .qlose-tool__index {
    font-family: var(--qlose-font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--qlose-muted);
    margin-bottom: 8px;
  }

  .qlose-tool__name {
    font-family: var(--qlose-font-sans);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--qlose-black);
    margin-bottom: 8px;
  }

  .qlose-tool__material {
    font-size: 12px;
    color: var(--qlose-muted);
    line-height: 1.5;
  }

  /* The source drops straight to one column at 900px. */
  @media (max-width: 1200px) {
    .qlose-tools__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .qlose-tools {
      padding-block: 60px;
    }

    .qlose-tools__header {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 40px;
    }

    .qlose-tools__cta {
      margin-top: 40px;
    }
  }

  @media (max-width: 700px) {
    .qlose-tools__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE tools grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow_index", "label": "Eyebrow index", "default": "02 /" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow text", "default": "WHAT'S INSIDE" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>FIVE TOOLS. ONE <em>system</em>.</p>",
      "info": "Italic renders as the serif accent, bold as the stroked outline."
    },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now" },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Leave empty to scroll back up to the product on this page. Clear the label to drop the button."
    }
  ],
  "blocks": [
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        { "type": "text", "id": "index", "label": "Index", "default": "01" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Angled Floss Pick" },
        { "type": "text", "id": "material", "label": "Material" }
      ]
    }
  ],
  "presets": [{ "name": "QLOSE tools grid" }]
}
{% endschema %}
