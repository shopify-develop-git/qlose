{%- comment -%}
  Ported from docs/design-source/about.html and routine.html, both section
  .bottom-cta. The two pages use the same block in opposite polarities --
  about on bone, routine inverted on black -- so the theme is a setting
  rather than two near-identical sections.
{%- endcomment -%}

<section
  class="qlose-cta-band qlose-cta-band--{{ section.settings.theme }}{% if section.settings.size == 'compact' %} qlose-cta-band--compact{% endif %}"
>
  <div class="qlose-cta-band__inner">
    <h2 class="qlose-cta-band__heading qlose-display">
      {{- section.settings.heading | replace: '<p>', '' | replace: '</p>', '' -}}
    </h2>

    {%- if section.settings.text != blank -%}
      <div class="qlose-cta-band__text">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="qlose-cta-band__actions">
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>
          {%- render 'qlose-button',
              label: block.settings.label,
              url: block.settings.url,
              style: block.settings.style
          -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .qlose-cta-band {
    padding: var(--qlose-section-pad) var(--qlose-gutter);
  }

  .qlose-cta-band--light {
    background: var(--qlose-bone);
    border-top: 1px solid var(--qlose-divider);
  }

  .qlose-cta-band--dark {
    background: var(--qlose-black);
    color: var(--qlose-white);
    padding-block: calc(var(--qlose-section-pad) + 20px);
  }

  /* The measure sits on the heading and the copy separately, the way the source
     writes it, rather than on one wrapper around both. On the dark band those
     two differ -- a 1000px headline over a 600px paragraph -- which a single
     wrapper cannot express. */
  .qlose-cta-band__inner {
    margin: 0 auto;
    text-align: center;
  }

  .qlose-cta-band__heading {
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: 40px;
    font-size: clamp(48px, 6vw, 96px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--qlose-black);
  }

  .qlose-cta-band--dark .qlose-cta-band__heading {
    max-width: 1000px;
    margin-bottom: 24px;
    color: var(--qlose-white);
    font-size: clamp(48px, 7vw, 120px);
    letter-spacing: -0.05em;
  }

  .qlose-cta-band__text {
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 40px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--qlose-graphite);
  }

  .qlose-cta-band--dark .qlose-cta-band__text {
    font-size: 16px;
    /* Source used rgba(255,255,255,0.7) = 7.4:1 on black, which passes. */
    color: rgba(255, 255, 255, 0.7);
  }

  /* The FAQ page closes on a shorter band than the Routine page does: same
     ingredients, two thirds the depth, and type a size down. A modifier rather
     than a third theme, so the pages already using this section keep their
     measurements untouched. */
  .qlose-cta-band--compact {
    padding-block: 80px;
  }

  .qlose-cta-band--compact .qlose-cta-band__heading {
    font-size: clamp(36px, 5vw, 72px);
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }

  .qlose-cta-band--compact .qlose-cta-band__text {
    max-width: 500px;
    margin-bottom: 32px;
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .qlose-cta-band--compact {
      padding-block: 60px;
    }
  }

  /* The primary button is black on black in the dark theme, so invert it. */
  .qlose-cta-band--dark .qlose-btn--primary {
    background: var(--qlose-white);
    color: var(--qlose-black);
  }

  .qlose-cta-band--dark .qlose-btn--primary:hover {
    background: var(--qlose-bone);
  }

  .qlose-cta-band--dark .qlose-btn--ghost {
    color: var(--qlose-white);
    border-color: var(--qlose-white);
  }

  .qlose-cta-band--dark .qlose-btn--ghost:hover {
    background: var(--qlose-white);
    color: var(--qlose-black);
  }

  .qlose-cta-band__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }


{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE CTA band",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Theme",
      "options": [
        { "value": "light", "label": "Light (bone)" },
        { "value": "dark", "label": "Dark (black)" }
      ],
      "default": "light"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>READY TO START YOUR <em>routine</em>.</p>",
      "info": "Italic renders as the serif accent, bold as the stroked outline."
    },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the kits" },
        { "type": "url", "id": "url", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "ghost", "label": "Ghost" },
            { "value": "underline", "label": "Underline" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [{ "name": "QLOSE CTA band" }]
}
{% endschema %}
