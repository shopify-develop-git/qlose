{%- comment -%}
  Ported from docs/design-source/journal.html, section .categories.

  Its own section because that is where the source puts it: between the hero
  and the featured piece, above everything it filters. Rendering it from inside
  the article grid pushed it below the featured article, which reads as a
  filter for the grid alone rather than for the journal.

  The chips are the blog's own tags. "All" shows whether or not any exist -- it
  is a real state, the one the reader is already in -- so the band is part of
  the page rather than something that appears once enough articles are filed.
{%- endcomment -%}

{%- liquid
  assign target = blog
  if section.settings.blog != blank
    assign target = blogs[section.settings.blog]
  endif
-%}

<nav class="qlose-articles__filters" aria-label="{{ section.settings.filter_label }}">
  <div class="qlose-articles__filters-inner">
    <a
      class="qlose-articles__filter{% if current_tags == blank %} qlose-articles__filter--active{% endif %}"
      href="{{ target.url }}"
    >{{ section.settings.filter_all_label }}</a>
    {%- for tag in target.all_tags -%}
      <a
        class="qlose-articles__filter{% if current_tags contains tag %} qlose-articles__filter--active{% endif %}"
        href="{{ target.url }}/tagged/{{ tag | handleize }}"
      >{{ tag }}</a>
    {%- endfor -%}
  </div>
</nav>

{% stylesheet %}
  /* Ruled top and bottom, scrolling sideways rather than wrapping: six
     categories on a phone would otherwise break into two ragged lines. The
     rules run with the content rail rather than edge to edge, since the source
     puts them on the same element that carries the max-width. */
  .qlose-articles__filters {
    max-width: var(--qlose-max);
    margin-inline: auto;
    padding: 32px var(--qlose-gutter);
    border-top: 1px solid var(--qlose-divider);
    border-bottom: 1px solid var(--qlose-divider);
    overflow-x: auto;
  }

  .qlose-articles__filters-inner {
    display: flex;
    gap: 32px;
  }

  .qlose-articles__filter {
    font-family: var(--qlose-font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--qlose-muted);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  /* The current category is marked by the accent rule under it, not by colour
     alone -- the source draws the same underline on hover. */
  .qlose-articles__filter:hover,
  .qlose-articles__filter--active {
    color: var(--qlose-black);
    border-bottom-color: var(--qlose-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .qlose-articles__filter {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QLOSE article filters",
  "tag": "div",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Defaults to the blog being viewed." },
    { "type": "text", "id": "filter_label", "label": "Accessible label", "default": "Filter by topic" },
    { "type": "text", "id": "filter_all_label", "label": "All label", "default": "— All" }
  ],
  "presets": [{ "name": "QLOSE article filters" }]
}
{% endschema %}
