    "hero": {
      "type": "qlose-routine-hero",
      "settings": {
        "meta_left": "THE METHOD",
        "meta_right": "THE COMPLETE ROUTINE / 3 MINUTES",
        "heading": "<p>THE FIVE-<br><strong>STEP</strong><br><em>clean</em>.</p>",
        "lead": "<p>Most people brush and call it done. A real clean happens when every tool works in sequence, floss to disrupt, brush to clean, then a two-step finish on the tongue.</p>"
      }
    },
